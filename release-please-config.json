{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "auto-read-otp",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "gradle.properties" },
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "skills/auto-read-otp/SKILL.md" },
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".cursor-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "gemini-extension.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[0].source.ref" },
        { "type": "json", "path": ".agents/plugins/marketplace.json", "jsonpath": "$.plugins[0].source.ref" }
      ]
    }
  }
}
